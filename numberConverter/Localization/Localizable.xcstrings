          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende bei der Umrechnung zwischen Oktal und Hexadezimal die Binärdarstellung als Zwischenschritt."
          }
        },
        "fr": {
          "stringUnit": {
