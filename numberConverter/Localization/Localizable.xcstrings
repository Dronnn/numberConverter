        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "    10 |   2    |  8   |  16\n  ----------------------------\n   0   | 0      |  0   |  0\n   1   | 1      |  1   |  1\n   2   | 10     |  2   |  2\n   3   | 11     |  3   |  3\n   4   | 100    |  4   |  4\n   5   | 101    |  5   |  5\n   6   | 110    |  6   |  6\n   7   | 111    |  7   |  7\n   8   | 1000   |  10  |  8\n   9   | 1001   |  11  |  9\n   10  | 1010   |  12  |  A\n   11  | 1011   |  13  |  B\n   12  | 1100   |  14  |  C\n   13  | 1101   |  15  |  D\n   14  | 1110   |  16  |  E\n   15  | 1111   |  17  |  F\n   16  | 10000  |  20  |  10\n   17  | 10001  |  21  |  11\n   18  | 10010  |  22  |  12\n   19  | 10011  |  23  |  13\n   20  | 10100  |  24  |  14\n   etc."
          }
        }
      }
    },
    "help.page1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What are number systems?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что такое системы счисления?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué son los sistemas de numeración?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was sind Zahlensysteme?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu’est-ce qu’un système de numération ?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que são sistemas de numeração?"
          }
        }
      }
    },
    "help.page2.division": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "19 : 2 = 9 remainder 1\n9  : 2 = 4 remainder 1\n4  : 2 = 2 remainder 0\n2  : 2 = 1 remainder 0\n1  : 2 = 0 remainder 1"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "19 : 2 = 9 остаток 1\n9  : 2 = 4 остаток 1\n4  : 2 = 2 остаток 0\n2  : 2 = 1 остаток 0\n1  : 2 = 0 остаток 1"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "19 : 2 = 9 resto 1\n9  : 2 = 4 resto 1\n4  : 2 = 2 resto 0\n2  : 2 = 1 resto 0\n1  : 2 = 0 resto 1"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "19 : 2 = 9 Rest 1\n9  : 2 = 4 Rest 1\n4  : 2 = 2 Rest 0\n2  : 2 = 1 Rest 0\n1  : 2 = 0 Rest 1"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "19 : 2 = 9 reste 1\n9  : 2 = 4 reste 1\n4  : 2 = 2 reste 0\n2  : 2 = 1 reste 0\n1  : 2 = 0 reste 1"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "19 : 2 = 9 resto 1\n9  : 2 = 4 resto 1\n4  : 2 = 2 resto 0\n2  : 2 = 1 resto 0\n1  : 2 = 0 resto 1"
          }
        }
      }
    },
    "help.page2.p1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To convert a nonnegative whole number from decimal, repeatedly divide it by the target base until the quotient is zero. Read the remainders in reverse order to obtain the result. For a negative number, convert its magnitude and then restore the minus sign."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для перевода целого неотрицательного числа из десятичной системы последовательно делите его на основание нужной системы с остатком. Продолжайте до нулевого частного. Остатки, записанные в обратном порядке, образуют результат. Для отрицательного числа сначала переведите модуль, затем верните знак минус."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para convertir un entero no negativo desde decimal, divídelo sucesivamente entre la base de destino hasta obtener un cociente de cero. Los restos, leídos en orden inverso, forman el resultado. Para un número negativo, convierte su valor absoluto y vuelve a añadir el signo menos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um eine nichtnegative ganze Dezimalzahl umzurechnen, teile sie wiederholt durch die Zielbasis, bis der Quotient null ist. Die Reste ergeben in umgekehrter Reihenfolge das Ergebnis. Bei negativen Zahlen rechnest du zunächst den Betrag um und setzt danach das Minuszeichen davor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour convertir un entier positif ou nul depuis le système décimal, divisez-le successivement par la base cible jusqu’à obtenir un quotient nul. Lisez les restes dans l’ordre inverse pour obtenir le résultat. Pour un nombre négatif, convertissez sa valeur absolue, puis remettez le signe moins."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para converter um inteiro não negativo do sistema decimal, divida-o sucessivamente pela base de destino até obter quociente zero. Leia os restos na ordem inversa para obter o resultado. Para um número negativo, converta seu valor absoluto e depois recoloque o sinal de menos."
          }
        }
      }
    },
    "help.page2.p10": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the final quotient and the remainder to get 23. Nineteen sweets are written as 23 in octal. The quantity stays the same; only its representation changes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вот и всё. Перепишем остатки в порядке обратном их получению: 23. Это есть искомое число. То есть, девятнадцать конфеток в восьмеричной системе запишется как 23, но количество конфет от этого не поменяется. Изменятся только цифры, используемые для записи."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee el último cociente y el resto: obtenemos 23. Diecinueve caramelos se escriben como 23 en octal. La cantidad no cambia; solo cambia su representación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus dem letzten Quotienten und dem Rest ergibt sich 23. Neunzehn Bonbons werden oktal als 23 geschrieben. Die Menge bleibt gleich; nur ihre Darstellung ändert sich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dernier quotient et le reste donnent 23. Dix-neuf bonbons s’écrivent 23 en octal. La quantité reste identique ; seule sa représentation change."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O último quociente e o resto dão 23. Dezenove balas são escritas como 23 em octal. A quantidade permanece igual; apenas sua representação muda."
          }
        }
      }
    },
    "help.page2.p11": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a hexadecimal example, let’s convert decimal 762:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для примера перевода в шестнадцатеричную систему возьмём десятичное число 762:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como ejemplo hexadecimal, convirtamos el número decimal 762:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Hexadezimalbeispiel rechnen wir die Dezimalzahl 762 um:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l’hexadécimal, convertissons le nombre décimal 762 :"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como exemplo hexadecimal, vamos converter o número decimal 762:"
          }
        }
      }
    },
    "help.page2.p12": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace remainder 10 with A and remainder 15 with F. The result is 762 in decimal = 2FA in hexadecimal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остатку 10 соответствует цифра A, а остатку 15 цифра F. Получаем: 762 в десятичной системе = 2FA в шестнадцатеричной."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye el resto 10 por A y el resto 15 por F. El resultado es: 762 en decimal = 2FA en hexadecimal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetze den Rest 10 durch A und den Rest 15 durch F. Das Ergebnis ist: 762 dezimal = 2FA hexadezimal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacez le reste 10 par A et le reste 15 par F. Le résultat est : 762 en décimal = 2FA en hexadécimal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua o resto 10 por A e o resto 15 por F. O resultado é: 762 em decimal = 2FA em hexadecimal."
          }
        }
      }
    },
    "help.page2.p13": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So 762 sweets are written as 2FA in hexadecimal. Again, the quantity is unchanged; only the digits used to write it are different."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вот и всё. Это есть искомое число. То есть, 762 конфетки в шестнадцатеричной системе запишется как 2FA, но количество конфеток от этого не поменяется. Изменятся только цифры, используемые для записи."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así, 762 caramelos se escriben como 2FA en hexadecimal. La cantidad sigue siendo la misma; solo cambian los dígitos usados para escribirla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "762 Bonbons werden hexadezimal also als 2FA geschrieben. Wieder bleibt die Menge gleich; nur die verwendeten Ziffern ändern sich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainsi, 762 bonbons s’écrivent 2FA en hexadécimal. La quantité ne change toujours pas ; seuls les chiffres utilisés diffèrent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim, 762 balas são escritas como 2FA em hexadecimal. A quantidade continua igual; apenas os algarismos usados mudam."
          }
        }
      }
    },
    "help.page2.p2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example, let’s convert decimal 19 to binary. The same method works when converting from decimal to any other base."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для примера переведём 19 из десятичной системы в двоичную. Тот же способ применяется при переводе из десятичной системы в любую другую систему счисления."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ejemplo, convirtamos el número decimal 19 a binario. El mismo método sirve para pasar de decimal a cualquier otra base."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechnen wir beispielsweise die Dezimalzahl 19 in eine Binärzahl um. Die Methode funktioniert genauso für jede andere Zielbasis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertissons par exemple le nombre décimal 19 en binaire. La même méthode fonctionne pour toute autre base cible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por exemplo, vamos converter o número decimal 19 para binário. O mesmo método funciona para qualquer outra base de destino."
          }
        }
      }
    },
    "help.page2.p3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are several ways to write out the calculation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Существует несколько способов записи (оформления)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay varias formas de escribir el cálculo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rechenweg lässt sich auf verschiedene Arten aufschreiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calcul peut s’écrire de plusieurs façons."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há várias maneiras de escrever o cálculo."
          }
        }
      }
    },
    "help.page2.p4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First method:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первый способ записи:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primer método:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erste Schreibweise:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Première méthode :"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro método:"
          }
        }
      }
    },
    "help.page2.p5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The final division produces a quotient of zero. That is where we stop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последнее деление даёт нулевое частное. На этом останавливаемся."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última división da un cociente de cero. Aquí nos detenemos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der letzten Division ist der Quotient null. Hier hören wir auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière division donne un quotient nul. Nous nous arrêtons ici."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A última divisão tem quociente zero. Paramos aqui."
          }
        }
      }
    },
    "help.page2.p6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now read the remainders from bottom to top to finish the conversion."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь запишем остатки от деления в обратном порядке. Перевод завершён."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora lee los restos de abajo arriba para completar la conversión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies die Reste nun von unten nach oben ab. Damit ist die Umrechnung abgeschlossen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez maintenant les restes de bas en haut pour terminer la conversion."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora leia os restos de baixo para cima para concluir a conversão."
          }
        }
      }
    },
    "help.page2.p7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "19 in decimal = 10011 in binary."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "19 в десятичной системе = 10011 в двоичной."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "19 en decimal = 10011 en binario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "19 dezimal = 10011 binär."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "19 en décimal = 10011 en binaire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "19 em decimal = 10011 em binário."
          }
        }
      }
    },
    "help.page2.p8": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also use long division. Stop when the quotient is smaller than the target base. That quotient becomes the first digit of the result. For binary, the final nonzero quotient is 1."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть ещё один способ записи, тут используется запись деления в столбик. Признаком конца при таком делении будет получение частного меньшего основания системы счисления. При переводе в двоичную систему это единица. Но именно с неё и будет начинаться наше искомое число."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes usar la división larga. Detente cuando el cociente sea menor que la base de destino. Ese cociente será el primer dígito del resultado. En binario, el último cociente distinto de cero es 1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst auch schriftlich dividieren. Höre auf, sobald der Quotient kleiner als die Zielbasis ist. Dieser Quotient wird zur ersten Ziffer des Ergebnisses. Binär ist der letzte von null verschiedene Quotient 1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez aussi poser les divisions. Arrêtez-vous lorsque le quotient devient inférieur à la base cible. Ce quotient est le premier chiffre du résultat. En binaire, le dernier quotient non nul est 1."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode usar a divisão longa. Pare quando o quociente for menor que a base de destino. Esse quociente será o primeiro algarismo do resultado. No binário, o último quociente diferente de zero é 1."
          }
        }
      }
    },
    "help.page2.p9": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now let’s convert decimal 19 to octal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь переведём десятичное число 19 в восьмеричную систему."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora convirtamos el número decimal 19 a octal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechnen wir die Dezimalzahl 19 nun ins Oktalsystem um."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertissons maintenant le nombre décimal 19 en octal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora vamos converter o número decimal 19 para octal."
          }
        }
      }
    },
    "help.page2.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert whole numbers from decimal to other bases"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как переводить целые числа из десятичной системы счисления в другие системы."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir enteros de decimal a otras bases"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganze Dezimalzahlen in andere Basen umrechnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir des entiers décimaux vers d’autres bases"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converter inteiros decimais para outras bases"
          }
        }
      }
    },
    "help.page3.p1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert the whole and fractional parts separately. For 23.89, first convert 23, then convert 0.89. Repeatedly multiply the fractional part by the target base, which is 2 for binary. At each step, record the whole part of the product and continue with its fractional part. Stop when the fractional part is zero or you have enough digits. Unlike whole-number conversion, record these digits in the order they are produced."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Целую и дробную части переводят отдельно. Для числа 23.89 сначала переводим 23, затем 0.89. Дробную часть последовательно умножаем на основание нужной системы, например на 2 для двоичной. На каждом шаге записываем целую часть произведения и продолжаем с дробной частью. Останавливаемся, когда дробная часть равна нулю или получено достаточно знаков. В отличие от перевода целой части, цифры записываются в порядке получения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte por separado las partes entera y fraccionaria. Para 23.89, convierte primero 23 y después 0.89. Multiplica sucesivamente la parte fraccionaria por la base de destino, que es 2 en binario. En cada paso, anota la parte entera del producto y continúa con su parte fraccionaria. Detente cuando esta sea cero o tengas suficientes dígitos. A diferencia de los enteros, estos dígitos se escriben en el orden en que se obtienen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechne den ganzzahligen Anteil und den Bruchteil getrennt um. Bei 23.89 rechnest du erst 23 um, dann 0.89. Multipliziere den Bruchteil wiederholt mit der Zielbasis, bei Binärzahlen also mit 2. Notiere bei jedem Schritt den ganzzahligen Anteil des Produkts und fahre mit dessen Bruchteil fort. Höre auf, wenn der Bruchteil null ist oder genügend Ziffern vorliegen. Anders als bei ganzen Zahlen werden die Ziffern in der Reihenfolge ihres Auftretens notiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertissez séparément la partie entière et la partie fractionnaire. Pour 23.89, convertissez d’abord 23, puis 0.89. Multipliez successivement la partie fractionnaire par la base cible, soit 2 pour le binaire. À chaque étape, notez la partie entière du produit et continuez avec sa partie fractionnaire. Arrêtez-vous lorsque celle-ci est nulle ou lorsque vous avez assez de chiffres. Contrairement aux entiers, ces chiffres se notent dans l’ordre où ils sont obtenus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converta separadamente a parte inteira e a parte fracionária. Para 23.89, converta primeiro 23 e depois 0.89. Multiplique sucessivamente a parte fracionária pela base de destino, que é 2 no binário. Em cada etapa, anote a parte inteira do produto e continue com sua parte fracionária. Pare quando ela for zero ou houver algarismos suficientes. Ao contrário dos inteiros, esses algarismos são escritos na ordem em que aparecem."
          }
        }
      }
    },
    "help.page3.p2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: 23.89\nSeparate the fractional part: 0.89.\n1. 0.89 * 2 = 1.78. Record 1; keep 0.78.\n2. 0.78 * 2 = 1.56. Record 1; keep 0.56.\n3. 0.56 * 2 = 1.12. Record 1; keep 0.12.\n4. 0.12 * 2 = 0.24. Record 0; keep 0.24.\nContinue in the same way.\nRounded to 15 fractional digits, we get approximately 0.111000111101100 in binary.\nThe whole part, 23, is 10111 in binary.\nCombining the two parts gives approximately 10111.111000111101100."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пример: 23.89\nОтделим дробную часть: 0.89.\n1. 0.89 * 2 = 1.78. Записываем 1, оставляем 0.78.\n2. 0.78 * 2 = 1.56. Записываем 1, оставляем 0.56.\n3. 0.56 * 2 = 1.12. Записываем 1, оставляем 0.12.\n4. 0.12 * 2 = 0.24. Записываем 0, оставляем 0.24.\nПродолжаем тем же способом.\nОкругляя до 15 дробных разрядов, получаем приближённо 0.111000111101100.\nЦелая часть 23 в двоичной системе: 10111.\nОбъединяем части: приближённо 10111.111000111101100."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejemplo: 23.89\nSeparamos la parte fraccionaria: 0.89.\n1. 0.89 * 2 = 1.78. Anotamos 1; conservamos 0.78.\n2. 0.78 * 2 = 1.56. Anotamos 1; conservamos 0.56.\n3. 0.56 * 2 = 1.12. Anotamos 1; conservamos 0.12.\n4. 0.12 * 2 = 0.24. Anotamos 0; conservamos 0.24.\nContinuamos igual.\nAl redondear a 15 dígitos fraccionarios, obtenemos aproximadamente 0.111000111101100 en binario.\nLa parte entera, 23, es 10111 en binario.\nAl combinar ambas partes obtenemos aproximadamente 10111.111000111101100."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispiel: 23.89\nWir trennen den Bruchteil ab: 0.89.\n1. 0.89 * 2 = 1.78. Notiere 1; behalte 0.78.\n2. 0.78 * 2 = 1.56. Notiere 1; behalte 0.56.\n3. 0.56 * 2 = 1.12. Notiere 1; behalte 0.12.\n4. 0.12 * 2 = 0.24. Notiere 0; behalte 0.24.\nSo geht es weiter.\nAuf 15 Nachkommastellen gerundet erhalten wir binär ungefähr 0.111000111101100.\nDer ganzzahlige Anteil 23 ist binär 10111.\nZusammen ergibt das ungefähr 10111.111000111101100."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemple : 23.89\nIsolons la partie fractionnaire : 0.89.\n1. 0.89 * 2 = 1.78. Notez 1 ; gardez 0.78.\n2. 0.78 * 2 = 1.56. Notez 1 ; gardez 0.56.\n3. 0.56 * 2 = 1.12. Notez 1 ; gardez 0.12.\n4. 0.12 * 2 = 0.24. Notez 0 ; gardez 0.24.\nContinuez de la même façon.\nEn arrondissant à 15 chiffres fractionnaires, nous obtenons environ 0.111000111101100 en binaire.\nLa partie entière 23 vaut 10111 en binaire.\nEn réunissant les deux parties, on obtient environ 10111.111000111101100."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemplo: 23.89\nSeparamos a parte fracionária: 0.89.\n1. 0.89 * 2 = 1.78. Anotamos 1; mantemos 0.78.\n2. 0.78 * 2 = 1.56. Anotamos 1; mantemos 0.56.\n3. 0.56 * 2 = 1.12. Anotamos 1; mantemos 0.12.\n4. 0.12 * 2 = 0.24. Anotamos 0; mantemos 0.24.\nContinuamos da mesma forma.\nArredondando para 15 algarismos fracionários, obtemos aproximadamente 0.111000111101100 em binário.\nA parte inteira, 23, é 10111 em binário.\nJuntando as duas partes, obtemos aproximadamente 10111.111000111101100."
          }
        }
      }
    },
    "help.page3.p3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some fractions never reach a zero remainder in another base, so their representations repeat forever. A finite number of digits gives an approximation. Converting the 15-digit binary result above back to decimal gives approximately 23.890015, an error of about 0.000015."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не всякая конечная десятичная дробь имеет конечную запись в другой системе. Процесс может продолжаться бесконечно, поэтому ограниченное число разрядов даёт приближение. Если перевести приведённый выше результат с 15 дробными разрядами обратно в десятичную систему, получится приблизительно 23.890015. Погрешность составляет около 0.000015."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas fracciones nunca alcanzan un resto cero en otra base y su representación se repite indefinidamente. Un número finito de dígitos da una aproximación. Al convertir el resultado binario anterior de 15 dígitos a decimal obtenemos aproximadamente 23.890015, con un error de unos 0.000015."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Brüche erreichen in einer anderen Basis nie den Rest null; ihre Darstellung wiederholt sich unendlich. Eine endliche Ziffernfolge ist dann eine Näherung. Wird das obige Binärergebnis mit 15 Nachkommastellen zurück ins Dezimalsystem umgerechnet, ergibt sich ungefähr 23.890015. Der Fehler beträgt etwa 0.000015."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines fractions n’atteignent jamais un reste nul dans une autre base : leur représentation se répète indéfiniment. Un nombre fini de chiffres donne alors une approximation. En reconvertissant le résultat binaire précédent à 15 chiffres en décimal, on obtient environ 23.890015, soit une erreur d’environ 0.000015."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas frações nunca chegam a resto zero em outra base: sua representação se repete infinitamente. Uma quantidade finita de algarismos produz uma aproximação. Ao converter o resultado binário anterior com 15 algarismos de volta para decimal, obtemos aproximadamente 23.890015, com erro de cerca de 0.000015."
          }
        }
      }
    },
    "help.page3.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert fractions from decimal to other bases"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как переводить дробные числа из десятичной системы счисления в другие системы."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir fracciones de decimal a otras bases"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezimalbrüche in andere Basen umrechnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir des fractions décimales vers d’autres bases"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converter frações decimais para outras bases"
          }
        }
      }
    },
    "help.page4.p1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let’s use decimal 19 again, written as 10011 in binary."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для примера снова возьмём десятичное число 19, записанное как 10011 в двоичной системе."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volvamos a usar el número decimal 19, escrito como 10011 en binario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden wir wieder die Dezimalzahl 19, binär geschrieben als 10011."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprenons le nombre décimal 19, qui s’écrit 10011 en binaire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos usar novamente o número decimal 19, escrito como 10011 em binário."
          }
        }
      }
    },
    "help.page4.p2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Number the digit positions from right to left, starting at power 0."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Нам необходимо справа налево расставить над каждой цифрой числа степени начиная с нуля 0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Numera las posiciones de derecha a izquierda, empezando por la potencia 0."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Nummeriere die Stellen von rechts nach links, beginnend mit der Potenz 0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Numérotez les positions de droite à gauche, en commençant par la puissance 0."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Numere as posições da direita para a esquerda, começando pela potência 0."
          }
        }
      }
    },
    "help.page4.p3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Multiply each digit by the base raised to the power above that digit, then add the products. The symbol ^ denotes a power."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Алгоритм перевода заключается в том, что мы каждую цифру исходного числа должны умножить на основание системы счисления в степени (для обозначения степени используется \"^\"), которая написана над этой цифрой, и сложить все полученные произведения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Multiplica cada dígito por la base elevada a la potencia situada sobre él y suma los productos. El símbolo ^ indica una potencia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Multipliziere jede Ziffer mit der Basis hoch der über ihr stehenden Potenz. Addiere anschließend alle Produkte. Das Zeichen ^ bezeichnet eine Potenz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Multipliez chaque chiffre par la base élevée à la puissance indiquée au-dessus, puis additionnez les produits. Le symbole ^ indique une puissance."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Multiplique cada algarismo pela base elevada à potência indicada acima dele e some os produtos. O símbolo ^ indica uma potência."
          }
        }
      }
    },
    "help.page4.p4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For this example:\n1*2^4 = 16\n0*2^3 = 0\n0*2^2 = 0\n1*2^1 = 2\n1*2^0 = 1\n16 + 0 + 0 + 2 + 1 = 19"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вот так:\n1*2^4 = 16\n0*2^3 = 0\n0*2^2 = 0\n1*2^1 = 2\n1*2^0 = 1\n16 + 0 + 0 + 2 + 1 = 19"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este ejemplo:\n1*2^4 = 16\n0*2^3 = 0\n0*2^2 = 0\n1*2^1 = 2\n1*2^0 = 1\n16 + 0 + 0 + 2 + 1 = 19"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Beispiel:\n1*2^4 = 16\n0*2^3 = 0\n0*2^2 = 0\n1*2^1 = 2\n1*2^0 = 1\n16 + 0 + 0 + 2 + 1 = 19"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans cet exemple :\n1*2^4 = 16\n0*2^3 = 0\n0*2^2 = 0\n1*2^1 = 2\n1*2^0 = 1\n16 + 0 + 0 + 2 + 1 = 19"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste exemplo:\n1*2^4 = 16\n0*2^3 = 0\n0*2^2 = 0\n1*2^1 = 2\n1*2^0 = 1\n16 + 0 + 0 + 2 + 1 = 19"
          }
        }
      }
    },
    "help.page4.p5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In one line: 1*2^4 + 0*2^3 + 0*2^2 + 1*2^1 + 1*2^0 = 19."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть более краткая запись: 1*2^4 + 0*2^3 + 0*2^2 + 1*2^1 + 1*2^0 = 19"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una sola línea: 1*2^4 + 0*2^3 + 0*2^2 + 1*2^1 + 1*2^0 = 19."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einer Zeile: 1*2^4 + 0*2^3 + 0*2^2 + 1*2^1 + 1*2^0 = 19."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur une seule ligne : 1*2^4 + 0*2^3 + 0*2^2 + 1*2^1 + 1*2^0 = 19."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em uma linha: 1*2^4 + 0*2^3 + 0*2^2 + 1*2^1 + 1*2^0 = 19."
          }
        }
      }
    },
    "help.page4.powers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "powers: 4   3   2   1   0\ndigits: 1   0   0   1   1"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "степени: 4   3   2   1   0\nчисло  : 1   0   0   1   1"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "potencias: 4   3   2   1   0\ndígitos  : 1   0   0   1   1"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Potenzen: 4   3   2   1   0\nZiffern : 1   0   0   1   1"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "puissances: 4   3   2   1   0\nchiffres  : 1   0   0   1   1"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "potências: 4   3   2   1   0\ndígitos  : 1   0   0   1   1"
          }
        }
      }
    },
    "help.page4.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert whole numbers from other bases to decimal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод целых чисел из любой другой системы в десятичную"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir enteros de otras bases a decimal"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganze Zahlen anderer Basen in Dezimalzahlen umrechnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir des entiers d’autres bases en décimal"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converter inteiros de outras bases para decimal"
          }
        }
      }
    },
    "help.page5.p1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert a fractional part in the same way as a whole number, but assign negative powers from left to right after the point: -1, -2, -3, and so on. As before, ^ denotes a power."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дробную часть переводят так же, как целую, но после точки степени расставляют слева направо и берут отрицательными: -1, -2, -3 и так далее. Знак ^ обозначает возведение в степень."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte fraccionaria se convierte igual que la entera, pero las potencias se asignan de izquierda a derecha después del punto y son negativas: -1, -2, -3, etc. Como antes, ^ indica una potencia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bruchteil wird wie eine ganze Zahl umgerechnet. Nach dem Punkt werden jedoch von links nach rechts negative Potenzen vergeben: -1, -2, -3 und so weiter. Das Zeichen ^ bezeichnet wieder eine Potenz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La partie fractionnaire se convertit comme un entier, mais les puissances se placent de gauche à droite après le point et sont négatives : -1, -2, -3, etc. Le symbole ^ indique toujours une puissance."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A parte fracionária é convertida como a parte inteira, mas as potências são atribuídas da esquerda para a direita após o ponto e são negativas: -1, -2, -3 e assim por diante. O símbolo ^ continua indicando uma potência."
          }
        }
      }
    },
    "help.page5.p2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example, take the binary number 10011.101."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для примера опять возьмём число, записанное в двоичной системе счисления 10011.101"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ejemplo, tomemos el número binario 10011.101."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nehmen wir als Beispiel die Binärzahl 10011.101."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenons par exemple le nombre binaire 10011.101."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por exemplo, considere o número binário 10011.101."
          }
        }
      }
    },
    "help.page5.p3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. We can handle the whole part separately and focus on the fractional digits: 101."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Целую часть можно перевести отдельно. Здесь рассмотрим дробные разряды: 101."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Podemos convertir por separado la parte entera y centrarnos en los dígitos fraccionarios: 101."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Den ganzzahligen Anteil können wir getrennt behandeln. Hier betrachten wir die Nachkommastellen: 101."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Nous pouvons traiter la partie entière séparément et nous concentrer sur les chiffres fractionnaires : 101."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Podemos converter a parte inteira separadamente e nos concentrar nos algarismos fracionários: 101."
          }
        }
      }
    },
    "help.page5.p4": {
