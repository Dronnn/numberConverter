            "value": "Fragen und Änderungen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions et modifications"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dúvidas e alterações"
          }
        }
      }
    },
    "privacy.section.6.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For privacy questions or deletion of support correspondence, contact the developer through Help. Non-confidential questions can also be posted in the project’s issue tracker. Issues are public: do not include private numbers, personal information, or payment details. This policy will be updated when the app’s data handling changes; the date above identifies the latest version."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По вопросам конфиденциальности или для удаления переписки обратитесь к разработчику через Справку. Неконфиденциальные вопросы также можно задать в разделе Issues репозитория проекта. Обращения там общедоступны: не публикуйте частные числа, персональные данные или платёжные сведения. При изменении обработки данных эта политика будет обновлена; дата вверху указывает её последнюю версию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para preguntas de privacidad o para eliminar la correspondencia de asistencia, contacta con el desarrollador desde Ayuda. Las preguntas no confidenciales también pueden publicarse en el registro de incidencias del proyecto. Las incidencias son públicas: no incluyas números privados, información personal ni datos de pago. Esta política se actualizará si cambia el tratamiento de datos de la app; la fecha anterior identifica la última versión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Fragen zum Datenschutz oder zur Löschung von Support-Nachrichten kontaktiere den Entwickler über Hilfe. Nicht vertrauliche Fragen kannst du auch im Issue-Tracker des Projekts stellen. Diese Einträge sind öffentlich: Veröffentliche dort keine privaten Zahlen, persönlichen Daten oder Zahlungsinformationen. Wenn sich die Datenverarbeitung der App ändert, wird diese Erklärung aktualisiert. Das Datum oben kennzeichnet die neueste Fassung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour toute question de confidentialité ou demande de suppression de la correspondance d’assistance, contactez le développeur depuis Aide. Les questions non confidentielles peuvent aussi être publiées dans le suivi des problèmes du projet. Ces publications sont publiques : n’y incluez pas de nombres privés, de données personnelles ou d’informations de paiement. Cette politique sera mise à jour si le traitement des données change ; la date ci-dessus indique la dernière version."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para dúvidas sobre privacidade ou para excluir a correspondência de suporte, entre em contato com o desenvolvedor pela Ajuda. Perguntas não confidenciais também podem ser publicadas no rastreador de problemas do projeto. As publicações são públicas: não inclua números privados, informações pessoais ou dados de pagamento. Esta política será atualizada se o tratamento de dados do app mudar; a data acima identifica a versão mais recente."
          }
        }
      }
    }
  },
  "version": "1.1"
}
