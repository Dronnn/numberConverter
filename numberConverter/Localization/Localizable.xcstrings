    "help.page7.p1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Converting between bases 2, 8, and 16 is particularly simple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод чисел между системами с основаниями 2, 8 и 16 является самым простым алгоритмом из всех ранее рассмотренных."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversión entre las bases 2, 8 y 16 es especialmente sencilla."
          }
        },
