    "help.page7.p15": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To convert between octal and hexadecimal, use binary as an intermediate step."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для перевода между восьмеричной и шестнадцатеричной системами используйте двоичную запись как промежуточную."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
