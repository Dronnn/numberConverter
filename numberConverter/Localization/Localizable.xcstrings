    "support.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this app helps you, you can leave a tip to support its development. Thank you!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если приложение вам полезно, вы можете поддержать его разработку. Спасибо!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esta app te resulta útil, puedes dejar una propina para apoyar su desarrollo. ¡Gracias!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dir die App hilft, kannst du ihre Entwicklung mit einem Trinkgeld unterstützen. Vielen Dank!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cette app vous est utile, vous pouvez laisser un pourboire pour soutenir son développement. Merci !"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se este app é útil para você, pode deixar uma gorjeta para apoiar seu desenvolvimento. Obrigado!"
          }
        }
      }
    },
    "support.optional": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips are optional, one-time purchases. All features remain available without a tip."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддержка добровольная, платёж разовый. Все функции доступны и без него."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las propinas son compras únicas y opcionales. Todas las funciones están disponibles sin dejar propina."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinkgelder sind freiwillige, einmalige Käufe. Alle Funktionen bleiben auch ohne Trinkgeld verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pourboires sont des achats uniques et facultatifs. Toutes les fonctions restent disponibles sans pourboire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gorjetas são compras únicas e opcionais. Todos os recursos continuam disponíveis sem gorjeta."
