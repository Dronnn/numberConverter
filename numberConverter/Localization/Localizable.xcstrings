    "help.page5.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert fractions from other bases to decimal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как переводить дробные числа из любой другой системы в десятичную"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir fracciones de otras bases a decimal"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brüche anderer Basen in Dezimalbrüche umrechnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir des fractions d’autres bases en décimal"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converter frações de outras bases para decimal"
          }
        }
      }
    },
    "help.page6.p1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The familiar methods for decimal arithmetic also work in other bases. Carrying and borrowing use the base of the number system."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Алгоритм, применяемый для выполнения операций в десятичной системе счисления, может применяться и в любой другой системе счисления без изменений."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los métodos habituales de la aritmética decimal también funcionan en otras bases. Las llevadas y los préstamos usan la base del sistema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vertrauten Verfahren der Dezimalarithmetik funktionieren auch in anderen Basen. Beim Übertrag und beim Ausleihen wird die jeweilige Basis verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les méthodes habituelles du calcul décimal fonctionnent aussi dans les autres bases. Les retenues et les emprunts utilisent la base du système choisi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os métodos habituais da aritmética decimal também funcionam em outras bases. O transporte e o empréstimo usam a base do sistema escolhido."
          }
        }
      }
    },
