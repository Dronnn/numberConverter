    "help.page7.p11": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take decimal 4538 and convert it to the other bases."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возьмём 4538 в десятичной системе и переведём во все остальные системы"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomemos el número decimal 4538 y convirtámoslo a las otras bases."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechnen wir die Dezimalzahl 4538 in die anderen Basen um."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenons le nombre décimal 4538 et convertissons-le dans les autres bases."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos converter o número decimal 4538 para as outras bases."
          }
        }
      }
    },
    "help.page7.p12": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decimal 4538 is 1000110111010 in binary."
