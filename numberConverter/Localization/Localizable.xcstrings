    "help.page6.p7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 - 0 = 0\n0 - 1: borrow from the next position and write 1.\n1 - 0 = 1\n1 - 1 = 0"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "        0 - 0 = 0\n        0 - 1 = занимаем из старшего разряда, и записываем в результат 1.\n        1 - 0 = 1\n        1 - 1 = 0"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0 - 0 = 0\n0 - 1: tomamos prestado de la posición siguiente y escribimos 1.\n1 - 0 = 1\n1 - 1 = 0"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0 - 0 = 0\n0 - 1: Leihe von der nächsthöheren Stelle und schreibe 1.\n1 - 0 = 1\n1 - 1 = 0"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0 - 0 = 0\n0 - 1 : empruntez à la position suivante et écrivez 1.\n1 - 0 = 1\n1 - 1 = 0"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "0 - 0 = 0\n0 - 1: pegue emprestado da próxima posição e escreva 1.\n1 - 0 = 1\n1 - 1 = 0"
          }
        }
      }
    },
