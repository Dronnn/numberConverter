            "value": "Pour passer de l’octal à l’hexadécimal ou inversement, utilisez le binaire comme étape intermédiaire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para converter entre octal e hexadecimal, use o binário como etapa intermediária."
          }
        }
      }
    },
    "help.page7.p16": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You only need to remember the digit conversion tables to convert between bases 2, 8, and 16."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таким образом, для перевода между системами с основаниями 2, 8 и 16 достаточно помнить таблицы соответствия цифр."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta con recordar las tablas de conversión de dígitos para convertir entre las bases 2, 8 y 16."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brauchst nur die Zifferntabellen zu kennen, um zwischen den Basen 2, 8 und 16 umzurechnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suffit de connaître les tables de conversion des chiffres pour convertir entre les bases 2, 8 et 16."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta lembrar as tabelas de conversão dos algarismos para converter entre as bases 2, 8 e 16."
          }
        }
      }
    },
    "help.page7.p2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decimal 19 is 10011 in binary, 23 in octal, and 13 in hexadecimal. Let’s convert between these representations."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Десятичное число 19 записывается как 10011 в двоичной системе, 23 в восьмеричной и 13 в шестнадцатеричной. Переведём эти записи друг в друга."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número decimal 19 es 10011 en binario, 23 en octal y 13 en hexadecimal. Convirtamos entre estas representaciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dezimalzahl 19 ist binär 10011, oktal 23 und hexadezimal 13. Rechnen wir zwischen diesen Darstellungen um."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre décimal 19 vaut 10011 en binaire, 23 en octal et 13 en hexadécimal. Passons d’une représentation à l’autre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número decimal 19 é 10011 em binário, 23 em octal e 13 em hexadecimal. Vamos converter entre essas representações."
          }
        }
      }
    },
    "help.page7.p3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First, recall the digit conversion table:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для перевода нам потребуется вспомнить таблицу"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero, recordemos la tabla de conversión de dígitos:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zunächst die Umrechnungstabelle der Ziffern:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappelons d’abord la table de conversion des chiffres :"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro, relembre a tabela de conversão dos algarismos:"
          }
        }
      }
    },
    "help.page7.p4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now rewrite it with leading zeros:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перепишем её в немного изменённом виде"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora la escribimos con ceros iniciales:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben wir sie nun mit führenden Nullen:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réécrivons-la avec des zéros en tête :"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora vamos reescrevê-la com zeros à esquerda:"
          }
        }
      }
    },
    "help.page7.p5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use three binary digits for each octal digit and four for each hexadecimal digit. Octal 7 is binary 111, and hexadecimal F is binary 1111. In unsigned notation, adding leading zeros does not change a number’s value; it gives each group the same width."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишем двоичные эквиваленты восьмеричных цифр тремя разрядами, а шестнадцатеричных четырьмя. Восьмеричной цифре 7 соответствует 111, а шестнадцатеричной F соответствует 1111. В беззнаковой записи ведущие нули не меняют значение числа, но позволяют выровнять группы по длине."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usamos tres dígitos binarios por cada dígito octal y cuatro por cada dígito hexadecimal. El 7 octal es 111 en binario; F hexadecimal es 1111. En una representación sin signo, añadir ceros iniciales no cambia el valor; solo iguala la anchura de los grupos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende drei Binärziffern je Oktalziffer und vier je Hexadezimalziffer. Oktal 7 ist binär 111, hexadezimal F ist binär 1111. Bei einer vorzeichenlosen Darstellung verändern führende Nullen den Wert nicht; sie vereinheitlichen nur die Gruppenbreite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez trois chiffres binaires par chiffre octal et quatre par chiffre hexadécimal. Le chiffre octal 7 vaut 111 en binaire, et le chiffre hexadécimal F vaut 1111. Dans une représentation non signée, ajouter des zéros en tête ne change pas la valeur ; cela donne simplement la même largeur à chaque groupe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use três algarismos binários para cada algarismo octal e quatro para cada algarismo hexadecimal. O 7 octal é 111 em binário; F hexadecimal é 1111. Em uma representação sem sinal, adicionar zeros à esquerda não muda o valor: apenas deixa os grupos com a mesma largura."
          }
        }
      }
    },
    "help.page7.p6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "And for hexadecimal:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Y para hexadecimal:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und für Hexadezimal:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et pour l’hexadécimal :"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E para hexadecimal:"
          }
        }
      }
    },
    "help.page7.p7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To convert binary 10011 to octal, group bits in threes from the right. Add leading zeros if needed: 010 011. Replace each group using the table: 010 becomes 2, and 011 becomes 3. The result is 23."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переведём двоичное число 10011 в восьмеричную систему. Мы должны разбить число на триады начиная с последней цифры. Если цифр для формирования триады не хватает, то просто добавляем в начало числа нужное количество нулей. Получим 010 и 011. Каждую триаду, по таблице, заменяем на соответствующую ей восьмеричную цифру. 010 по таблице заменится на 2, а 011 заменится на 3. Получаем 23."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para convertir el binario 10011 a octal, agrupamos los bits de tres en tres desde la derecha. Añadimos ceros iniciales si hace falta: 010 011. Según la tabla, 010 se sustituye por 2 y 011 por 3. El resultado es 23."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um binär 10011 in Oktal umzurechnen, gruppiere die Bits von rechts in Dreiergruppen. Ergänze bei Bedarf führende Nullen: 010 011. Ersetze jede Gruppe anhand der Tabelle: 010 wird zu 2, 011 zu 3. Das Ergebnis ist 23."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour convertir le binaire 10011 en octal, regroupez les bits par trois depuis la droite. Ajoutez des zéros en tête si nécessaire : 010 011. Selon la table, remplacez 010 par 2 et 011 par 3. Le résultat est 23."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para converter o binário 10011 para octal, agrupe os bits de três em três a partir da direita. Adicione zeros à esquerda, se necessário: 010 011. Pela tabela, substitua 010 por 2 e 011 por 3. O resultado é 23."
          }
        }
      }
    },
    "help.page7.p8": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To convert binary 10011 to hexadecimal, group bits in fours from the right: 0001 0011. Replace each group using the table: 0001 becomes 1, and 0011 becomes 3. The result is 13."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переведём двоичное число 10011 в шестнадцатеричную систему. Разобьём биты на группы по четыре справа налево. При необходимости добавим ведущие нули: 0001 0011. По таблице заменим 0001 на 1, а 0011 на 3. Получаем 13."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para convertir el binario 10011 a hexadecimal, agrupamos los bits de cuatro en cuatro desde la derecha: 0001 0011. Sustituimos 0001 por 1 y 0011 por 3. El resultado es 13."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Umrechnung von binär 10011 in Hexadezimal bilde von rechts Vierergruppen: 0001 0011. Ersetze 0001 durch 1 und 0011 durch 3. Das Ergebnis ist 13."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour convertir le binaire 10011 en hexadécimal, regroupez les bits par quatre depuis la droite : 0001 0011. Remplacez 0001 par 1 et 0011 par 3. Le résultat est 13."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para converter o binário 10011 para hexadecimal, agrupe os bits de quatro em quatro a partir da direita: 0001 0011. Substitua 0001 por 1 e 0011 por 3. O resultado é 13."
          }
        }
      }
    },
    "help.page7.p9": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To convert hexadecimal 13 to binary, replace 1 with 0001 and 3 with 0011. This gives 00010011. Remove the unnecessary leading zeros to get 10011."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переведём 13 из шестнадцатеричной в двоичную. 1 заменяем на 0001, а 3 - на 0011. Получаем 00010011 и отбрасываем незначащие нули в начале числа."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para convertir el hexadecimal 13 a binario, sustituimos 1 por 0001 y 3 por 0011. Obtenemos 00010011. Quitamos los ceros iniciales innecesarios y queda 10011."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um hexadezimal 13 in Binär umzuwandeln, ersetze 1 durch 0001 und 3 durch 0011. Das ergibt 00010011. Entferne die unnötigen führenden Nullen: 10011."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour convertir l’hexadécimal 13 en binaire, remplacez 1 par 0001 et 3 par 0011. Vous obtenez 00010011. Supprimez les zéros initiaux inutiles pour obtenir 10011."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para converter o hexadecimal 13 para binário, substitua 1 por 0001 e 3 por 0011. Obtemos 00010011. Remova os zeros iniciais desnecessários para obter 10011."
          }
        }
      }
    },
    "help.page7.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert between binary, octal, and hexadecimal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как переводить числа между системами с основаниями 2, 8 и 16"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir entre binario, octal y hexadecimal"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen Binär, Oktal und Hexadezimal umrechnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir entre binaire, octal et hexadécimal"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converter entre binário, octal e hexadecimal"
          }
        }
      }
    },
    "help.page8.p1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two ways to represent signed binary integers are sign-magnitude and two’s complement. In sign-magnitude, the most significant bit is the sign: 0 for positive, 1 for negative. With eight bits, its range is -127 to 127, and it has two representations of zero. Eight-bit two’s complement represents -128 to 127 with a single zero, and is the usual representation in modern computers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для представления знаковых двоичных целых чисел используют, в частности, прямой и дополнительный коды. В прямом коде старший бит обозначает знак: 0 для положительного числа, 1 для отрицательного. Восемь бит позволяют представить числа от -127 до 127, причём у нуля две записи. В дополнительном коде диапазон восьмибитного числа составляет от -128 до 127, а ноль имеет одну запись. Дополнительный код обычно используется в современных компьютерах."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos formas de representar enteros binarios con signo son signo y magnitud y complemento a dos. En signo y magnitud, el bit más significativo indica el signo: 0 para positivo y 1 para negativo. Con ocho bits, el rango es de -127 a 127 y existen dos representaciones del cero. El complemento a dos de ocho bits representa de -128 a 127 con un único cero y es el sistema habitual en los ordenadores modernos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Möglichkeiten zur Darstellung vorzeichenbehafteter Binärzahlen sind Vorzeichen und Betrag sowie das Zweierkomplement. Bei Vorzeichen und Betrag gibt das höchstwertige Bit das Vorzeichen an: 0 für positiv, 1 für negativ. Acht Bits reichen für -127 bis 127, wobei es zwei Darstellungen der Null gibt. Das Acht-Bit-Zweierkomplement reicht von -128 bis 127 und hat nur eine Null. Es ist in modernen Computern üblich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux représentations possibles des entiers binaires signés sont signe et valeur absolue, et complément à deux. Dans la première, le bit de poids fort indique le signe : 0 pour positif, 1 pour négatif. Sur huit bits, l’intervalle va de -127 à 127 et il existe deux représentations de zéro. Le complément à deux sur huit bits va de -128 à 127 avec un seul zéro ; c’est la représentation habituelle dans les ordinateurs modernes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas formas de representar inteiros binários com sinal são sinal e magnitude e complemento de dois. Em sinal e magnitude, o bit mais significativo indica o sinal: 0 para positivo, 1 para negativo. Com oito bits, o intervalo vai de -127 a 127 e existem duas representações de zero. O complemento de dois com oito bits representa de -128 a 127 com um único zero e é a representação habitual nos computadores modernos."
          }
        }
      }
    },
    "help.page8.p2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two’s complement allows subtraction to use addition. To represent a negative integer, first write its positive magnitude using the chosen bit width. Invert every bit, then add 1. These examples use one byte, so binary 1011 is padded to 00001011 before applying the transformation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнительный код позволяет выполнять вычитание с помощью сложения. Чтобы получить запись отрицательного целого числа, сначала запишите его положительный модуль с выбранной разрядностью. Затем замените все нули единицами, а единицы нулями и прибавьте 1. В примерах используется один байт: число 1011 сначала записывается как 00001011."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El complemento a dos permite realizar restas mediante sumas. Para representar un entero negativo, escribe primero su valor absoluto positivo con la anchura elegida. Invierte todos los bits y suma 1. Estos ejemplos usan un byte, por lo que 1011 se completa como 00001011 antes de aplicar la transformación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zweierkomplement ermöglicht Subtraktion durch Addition. Schreibe für eine negative ganze Zahl zunächst ihren positiven Betrag in der gewählten Bitbreite. Kehre alle Bits um und addiere 1. Die Beispiele verwenden ein Byte; aus 1011 wird daher zunächst 00001011."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le complément à deux permet d’effectuer une soustraction à l’aide d’une addition. Pour représenter un entier négatif, écrivez d’abord sa valeur absolue positive sur le nombre de bits choisi. Inversez tous les bits, puis ajoutez 1. Les exemples utilisent un octet : 1011 est donc d’abord complété en 00001011."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O complemento de dois permite realizar subtrações por meio de adições. Para representar um inteiro negativo, escreva primeiro seu valor absoluto positivo na largura escolhida. Inverta todos os bits e some 1. Os exemplos usam um byte; portanto, 1011 é primeiro completado como 00001011."
          }
        }
      }
    },
    "help.page8.p3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let’s represent -5 in two’s complement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Преобразуем отрицательное число −5, в дополнительный код."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Representemos -5 en complemento a dos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen wir -5 im Zweierkomplement dar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Représentons -5 en complément à deux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos representar -5 em complemento de dois."
          }
        }
      }
    },
    "help.page8.p4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write positive five in binary: 101."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возьмём число пять записанное в двоичной системе счисления: 101."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribimos cinco positivo en binario: 101."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die positive Fünf lautet binär: 101."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivons le nombre positif cinq en binaire : 101."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrevemos cinco positivo em binário: 101."
          }
        }
      }
    },
    "help.page8.p5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pad to one byte: 00000101."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Допишем в начало нули для получения представления как в ячейке памяти: 00000101."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completamos hasta un byte: 00000101."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergänze auf ein Byte: 00000101."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Complétons sur un octet : 00000101."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Completamos até um byte: 00000101."
          }
        }
      }
    },
    "help.page8.p6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invert every bit: 11111010."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменим все 0 на 1, а 1 на 0: 11111010"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invertimos todos los bits: 11111010."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehre alle Bits um: 11111010."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inversons tous les bits : 11111010."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Invertemos todos os bits: 11111010."
          }
        }
      }
    },
    "help.page8.p7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add 1: 11111010 + 1 = 11111011."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И прибавим 1: 11111010 + 1 = 11111011"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumamos 1: 11111010 + 1 = 11111011."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Addiere 1: 11111010 + 1 = 11111011."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutons 1 : 11111010 + 1 = 11111011."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somamos 1: 11111010 + 1 = 11111011."
          }
        }
      }
    },
    "help.page8.p8": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result, 11111011, represents -5 in eight-bit two’s complement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы получили число -5 записанное в дополнительном коде."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado, 11111011, representa -5 en complemento a dos de ocho bits."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis 11111011 stellt -5 im Acht-Bit-Zweierkomplement dar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat 11111011 représente -5 en complément à deux sur huit bits."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado 11111011 representa -5 em complemento de dois com oito bits."
          }
        }
      }
    },
