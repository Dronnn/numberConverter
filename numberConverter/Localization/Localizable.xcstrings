    "help.page1.p1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A number system is a way of writing numbers. The same quantity can be written in different ways."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно и то же количество можно записать по-разному. Система счисления определяет, какие символы для этого используются и как их читать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una misma cantidad se puede escribir de distintas formas. Un sistema de numeración determina los símbolos que usamos y cómo los interpretamos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselbe Menge kann unterschiedlich geschrieben werden. Ein Zahlensystem legt fest, welche Zeichen wir verwenden und wie wir sie lesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une même quantité peut s’écrire de plusieurs façons. Un système de numération définit les symboles utilisés et la manière de les interpréter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mesma quantidade pode ser escrita de formas diferentes. Um sistema de numeração define os símbolos usados e como interpretá-los."
          }
        }
      }
    },
